# Configuracion del Sistema FSD 2026
# Copie este archivo como .env y ajuste los valores

# Clave secreta para Flask (cambiar en produccion)
SECRET_KEY=clave-secreta-fsd-2026-cambiar-en-produccion

# Puerto de la aplicacion
FLASK_PORT=5000

# Modo debug (True para desarrollo, False para produccion)
FLASK_DEBUG=True
